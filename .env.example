NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGIN=*
MONGO_URI=mongodb://127.0.0.1:27017/easy-blinds

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ZeptoMail Email Service
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=your-zeptomail-token
ZEPTOMAIL_FROM_ADDRESS=noreply@measurepro.co
ZEPTOMAIL_FROM_NAME=noreply

# Firebase Cloud Messaging (Push Notifications for Salesman & Fitter apps)
# Option 1: Service account JSON file path or raw JSON string
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# Option 2: Individual service account credentials
FIREBASE_PROJECT_ID=measurepro-1e1f3
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@measurepro-1e1f3.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=
